<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#061428', overflow: 'hidden' }}>

    <svg width={1280} height={720} viewBox='0 0 1280 720' style={{ position: 'absolute', top: 0, left: 0 }}>
        <defs>
            <linearGradient id='q7bg' x1='0' y1='0' x2='1' y2='1'>
                <stop offset='0%' stopColor='#0B3D91' />
                <stop offset='60%' stopColor='#08265A' />
                <stop offset='100%' stopColor='#061428' />
            </linearGradient>
            <radialGradient id='q7g1' cx='0.2' cy='0.5' r='0.5'>
                <stop offset='0%' stopColor='#00B4D8' stopOpacity='0.30' />
                <stop offset='100%' stopColor='#00B4D8' stopOpacity='0' />
            </radialGradient>
            <radialGradient id='q7g2' cx='0.85' cy='0.55' r='0.5'>
                <stop offset='0%' stopColor='#FF7A18' stopOpacity='0.22' />
                <stop offset='100%' stopColor='#FF7A18' stopOpacity='0' />
            </radialGradient>
        </defs>
        <rect x='0' y='0' width='1280' height='720' fill='url(#q7bg)' />
        <rect x='0' y='0' width='1280' height='720' fill='url(#q7g1)' />
        <rect x='0' y='0' width='1280' height='720' fill='url(#q7g2)' />
        <g stroke='#4E8BD6' strokeOpacity='0.10' strokeWidth='1'>
            <line x1='0' y1='240' x2='1280' y2='240' />
            <line x1='0' y1='480' x2='1280' y2='480' />
            <line x1='420' y1='0' x2='420' y2='720' />
            <line x1='840' y1='0' x2='840' y2='720' />
        </g>
        <rect x='0' y='712' width='1280' height='8' fill='#00B4D8' />
        <rect x='860' y='712' width='420' height='8' fill='#FF7A18' />
    </svg>

    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, flexDirection: 'column', paddingLeft: 84, paddingRight: 84, paddingTop: 78, paddingBottom: 60 }}>

        {/* 章标 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#00B4D8', letterSpacing: 3 }}>CHAPTER 02</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>成果指标：实测数据</Text>
        </Box>
        <Text style={{ fontSize: 17, color: '#9DBBEA', marginTop: 12 }}>四项硬指标，全部来自实测记录，可追溯</Text>

        {/* 四指标 */}
        <Box style={{ flexDirection: 'row', gap: 20, marginTop: 42, flex: 1 }}>

            <Box style={{ flex: 1, background: 'rgba(255,255,255,0.06)', border: '1px solid rgba(255,255,255,0.12)', borderRadius: 14, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#7FD4E8', letterSpacing: 2 }}>精度</Text>
                <Text style={{ fontSize: 76, lineHeight: 0.92, fontWeight: 'bold', color: '#00B4D8' }}>0.724</Text>
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>mAP50</Text>
                    <Text style={{ fontSize: 14.5, color: '#A9C2E0', lineHeight: 1.5, marginTop: 5 }}>39 类 · conf=0.2 统一口径</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: 'rgba(255,255,255,0.06)', border: '1px solid rgba(255,255,255,0.12)', borderRadius: 14, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#7FD4E8', letterSpacing: 2 }}>速度</Text>
                <Text style={{ fontSize: 76, lineHeight: 0.92, fontWeight: 'bold', color: '#FFFFFF' }}>128<span style={{ fontSize: 30 }}>ms</span></Text>
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>单帧推理</Text>
                    <Text style={{ fontSize: 14.5, color: '#A9C2E0', lineHeight: 1.5, marginTop: 5 }}>区间 128–157ms，整机 ≥5 FPS</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: 'rgba(255,255,255,0.06)', border: '1px solid rgba(255,255,255,0.12)', borderRadius: 14, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFB37A', letterSpacing: 2 }}>韧性</Text>
                <Text style={{ fontSize: 76, lineHeight: 0.92, fontWeight: 'bold', color: '#FF7A18' }}>3.0<span style={{ fontSize: 30 }}>s</span></Text>
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>断流自愈</Text>
                    <Text style={{ fontSize: 14.5, color: '#A9C2E0', lineHeight: 1.5, marginTop: 5 }}>实测掐线 3.0s 自动重连续跑</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: 'rgba(255,255,255,0.06)', border: '1px solid rgba(255,255,255,0.12)', borderRadius: 14, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#7FD4E8', letterSpacing: 2 }}>闭环</Text>
                <Text style={{ fontSize: 76, lineHeight: 0.92, fontWeight: 'bold', color: '#00B4D8' }}>6<span style={{ fontSize: 30 }}>页</span></Text>
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>上位机终端</Text>
                    <Text style={{ fontSize: 14.5, color: '#A9C2E0', lineHeight: 1.5, marginTop: 5 }}>可视化 / 报警 / 追溯 / 统计全闭环</Text>
                </Box>
            </Box>

        </Box>

        {/* 底部洞察 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginTop: 26 }}>
            <Box style={{ width: 6, height: 32, background: '#FF7A18' }} />
            <Text style={{ fontSize: 20, color: '#DCE8F7' }}>
                判断：<span style={{ color: '#FFFFFF', fontWeight: 'bold' }}>指标已达到可上产线的水平</span> —— 满足高速产线 ≥ 5 pcs/s 节拍，且具备无人值守的自愈能力。
            </Text>
        </Box>
    </Box>

</Slide>
