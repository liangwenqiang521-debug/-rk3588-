<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', overflow: 'hidden' }}>

    {/* A 区 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 120, paddingLeft: 84, paddingTop: 40, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ width: 5, height: 36, background: '#0B3D91' }} />
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0B1C33' }}>技术主线已经贯通</Text>
    </Box>

    {/* B 区 60:40 */}
    <Box style={{ position: 'absolute', top: 132, left: 84, width: 1112, height: 506, flexDirection: 'row', gap: 28 }}>

        {/* 左 60%：链路图 */}
        <Box style={{ width: 646, height: 506, background: '#F4F7FB', border: '1px solid #E1E9F2', borderRadius: 14, padding: 30, flexDirection: 'column', position: 'relative' }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0B3D91', letterSpacing: 2 }}>全链路闭环</Text>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0B1C33', marginTop: 8 }}>数据 → 模型 → 边缘 → 上位机</Text>

            <svg width={586} height={330} viewBox='0 0 586 330' style={{ marginTop: 22 }}>
                <defs>
                    <linearGradient id='q8n' x1='0' y1='0' x2='1' y2='0'>
                        <stop offset='0%' stopColor='#0B3D91' />
                        <stop offset='100%' stopColor='#00B4D8' />
                    </linearGradient>
                </defs>
                {/* 四个节点 */}
                <g>
                    <rect x='8' y='30' width='124' height='70' rx='10' fill='url(#q8n)' />
                    <text x='70' y='62' fontSize='18' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter, sans-serif'>数据</text>
                    <text x='70' y='84' fontSize='12' fill='#CBE6F2' textAnchor='middle'>25689 图</text>

                    <rect x='154' y='30' width='124' height='70' rx='10' fill='url(#q8n)' />
                    <text x='216' y='62' fontSize='18' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter, sans-serif'>模型</text>
                    <text x='216' y='84' fontSize='12' fill='#CBE6F2' textAnchor='middle'>39 类</text>

                    <rect x='300' y='30' width='124' height='70' rx='10' fill='url(#q8n)' />
                    <text x='362' y='62' fontSize='18' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter, sans-serif'>边缘</text>
                    <text x='362' y='84' fontSize='12' fill='#CBE6F2' textAnchor='middle'>RK3588</text>

                    <rect x='446' y='30' width='124' height='70' rx='10' fill='url(#q8n)' />
                    <text x='508' y='62' fontSize='18' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter, sans-serif'>上位机</text>
                    <text x='508' y='84' fontSize='12' fill='#CBE6F2' textAnchor='middle'>6 页闭环</text>
                </g>
                {/* 箭头 */}
                <g fill='#7FB2E8'>
                    <polygon points='140,58 152,65 140,72' />
                    <polygon points='286,58 298,65 286,72' />
                    <polygon points='432,58 444,65 432,72' />
                </g>
                {/* 回流箭头（数据闭环） */}
                <path d='M508,120 C508,220 70,220 70,120' fill='none' stroke='#FF7A18' strokeWidth='2.5' strokeDasharray='7 7' />
                <polygon points='70,124 63,112 77,112' fill='#FF7A18' />
                <text x='289' y='205' fontSize='13' fill='#C46A1E' textAnchor='middle'>难例回流 · 数据闭环</text>
                {/* 底部状态条 */}
                <rect x='8' y='262' width='562' height='34' rx='8' fill='#E8EFF7' />
                <text x='289' y='284' fontSize='14' fill='#0B3D91' textAnchor='middle' fontWeight='bold'>全链路已实测贯通 · 端到端可复跑</text>
            </svg>
        </Box>

        {/* 右 40%：结论 */}
        <Box style={{ width: 438, height: 506, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 4, background: '#FF7A18', marginBottom: 20 }} />
                <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0B1C33', lineHeight: 1.3 }}>
                    该讲的不是<br />「能不能做」
                </Text>
                <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0B3D91', lineHeight: 1.3, marginTop: 8 }}>
                    而是「还能做多深」
                </Text>
            </Box>

            <Text style={{ fontSize: 17, color: '#5C6E82', lineHeight: 1.75 }}>
                技术主线全部打通、指标达标，说明这套系统已经具备从实验室走向真实产线的条件。
                接下来要回答的，是它到底能落在哪些行业、扩展成本有多高 —— 这正是下一章的内容。
            </Text>

            <Box style={{ background: '#0B3D91', borderRadius: 10, padding: '16px 22px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <FAIcon name='arrow-right' style={{ fill: '#00B4D8', width: 22, height: 22 }} />
                <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>下一章：应用场景 · 六大领域</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 84, bottom: 22, width: 1112, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#9AA9B8' }}>工业表面缺陷检测系统 · 开发进度汇报</Text>
        <Text style={{ fontSize: 14, color: '#9AA9B8' }}>08 / 14</Text>
    </Box>

</Slide>
