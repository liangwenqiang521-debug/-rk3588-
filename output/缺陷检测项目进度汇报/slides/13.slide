                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0B1C33' }}>弱类召回偏低</Text>
                    <Text style={{ fontSize: 15, color: '#5C6E82', lineHeight: 1.55, marginTop: 4 }}>
                        waist_folding / crease / warp 三类 F1 低于 0.5，属模型特征问题，需换数据源而非调参。
                    </Text>
                </Box>
            </Box>

            <Box style={{ height: 1, background: '#E3EAF2' }} />

            <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
