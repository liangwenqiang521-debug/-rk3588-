<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#071A36', overflow: 'hidden' }}>

    {/* 背景网格 + 光晕（SVG） */}
    <svg width={1280} height={720} viewBox='0 0 1280 720' style={{ position: 'absolute', top: 0, left: 0 }}>
        <defs>
            <linearGradient id='p3bg' x1='0' y1='0' x2='1' y2='1'>
                <stop offset='0%' stopColor='#0B3D91' />
                <stop offset='55%' stopColor='#0A2C68' />
                <stop offset='100%' stopColor='#061428' />
            </linearGradient>
            <radialGradient id='p3glow' cx='0.82' cy='0.32' r='0.55'>
                <stop offset='0%' stopColor='#00B4D8' stopOpacity='0.45' />
                <stop offset='100%' stopColor='#00B4D8' stopOpacity='0' />
            </radialGradient>
        </defs>
        <rect x='0' y='0' width='1280' height='720' fill='url(#p3bg)' />
        <rect x='0' y='0' width='1280' height='720' fill='url(#p3glow)' />
        {/* 网格纹理 */}
        <g stroke='#4E8BD6' strokeOpacity='0.13' strokeWidth='1'>
            <line x1='0' y1='180' x2='1280' y2='180' />
            <line x1='0' y1='360' x2='1280' y2='360' />
            <line x1='0' y1='540' x2='1280' y2='540' />
            <line x1='320' y1='0' x2='320' y2='720' />
            <line x1='640' y1='0' x2='640' y2='720' />
            <line x1='960' y1='0' x2='960' y2='720' />
        </g>
        {/* 右侧巨型章号水印 */}
        <text x='1000' y='600' fontSize='520' fontWeight='bold' fill='#FFFFFF' fillOpacity='0.05' textAnchor='middle' fontFamily='Inter, sans-serif'>01</text>
        {/* 底部强调光带 */}
        <rect x='0' y='712' width='1280' height='8' fill='#FF7A18' />
        <rect x='0' y='712' width='420' height='8' fill='#00B4D8' />
    </svg>

    {/* 内容 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, paddingLeft: 96, paddingTop: 236, flexDirection: 'column' }}>

        {/* 章号 + 眉标 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#00B4D8', letterSpacing: 3 }}>CHAPTER 01</Text>
            <Box style={{ width: 90, height: 2, background: 'rgba(255,255,255,0.25)' }} />
        </Box>

        {/* 章题 */}
        <Text style={{ marginTop: 26, fontSize: 66, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.15, letterSpacing: 2 }}>
            行业痛点：质检为什么难
        </Text>

        {/* 小标 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginTop: 34 }}>
            <Box style={{ width: 6, height: 34, background: '#FF7A18' }} />
            <Text style={{ fontSize: 25, color: '#BFD6EC', letterSpacing: 1 }}>
                人眼抽检的极限，就是智能质检的起点。
            </Text>
        </Box>
    </Box>

    {/* 页脚 */}
    <Box style={{ position: 'absolute', left: 96, bottom: 30, width: 1088, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#6E8BB0' }}>工业表面缺陷检测系统 · 应用场景与落地地图</Text>
        <Text style={{ fontSize: 14, color: '#6E8BB0' }}>03 / 12</Text>
    </Box>

</Slide>
