<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#061428', overflow: 'hidden' }}>

    {/* 全幅底图 */}
    <Image src="assets/hero_factory_line.png" style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, objectFit: 'cover' }} />
    {/* 深色蒙版（左侧更重，保证骑线白字可读） */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, background: 'linear-gradient(100deg, rgba(4,14,32,0.94) 0%, rgba(4,14,32,0.82) 42%, rgba(4,14,32,0.30) 78%, rgba(4,14,32,0.10) 100%)' }} />
    {/* 底部强调光带 */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 8, background: 'linear-gradient(90deg, #FF7A18 0%, #00B4D8 45%, rgba(0,180,216,0) 100%)' }} />

    {/* 左侧骑线文字块 */}
    <Box style={{ position: 'relative', zIndex: 2, width: 760, height: 720, paddingTop: 96, paddingLeft: 84, flexDirection: 'column' }}>

        {/* 眉标 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 34, height: 4, background: '#FF7A18' }} />
            <Text style={{ fontSize: 18, color: '#7FD4E8', letterSpacing: 4, fontWeight: 600 }}>深度学习 · 机器视觉 · 边缘部署</Text>
        </Box>

        {/* 主标 */}
        <Text style={{ marginTop: 30, fontSize: 74, lineHeight: 1.12, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 1 }}>
            工业表面缺陷检测系统
        </Text>

        {/* 副标 */}
        <Text style={{ marginTop: 22, fontSize: 26, lineHeight: 1.5, color: '#C7D6E6' }}>
            一套可落地的边缘智能质检平台
        </Text>

        {/* 强调短语 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 16, gap: 12 }}>
            <Text style={{ fontSize: 26, lineHeight: 1.5, color: '#FFFFFF', fontWeight: 'bold' }}>从「人眼抽检」到「NPU 全检」</Text>
        </Box>

        {/* 一行范围 */}
        <Text style={{ marginTop: 34, fontSize: 19, color: '#8FA6BC', letterSpacing: 0.5 }}>
            <span style={{ color: '#00B4D8', fontWeight: 'bold' }}>39 类缺陷</span> × <span style={{ color: '#00B4D8', fontWeight: 'bold' }}>RK3588 边缘推理</span> × <span style={{ color: '#00B4D8', fontWeight: 'bold' }}>上位机闭环</span>
        </Text>

        {/* 锚点数字区 */}
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 22, marginTop: 46 }}>
            <Text style={{ fontSize: 104, lineHeight: 0.9, fontWeight: 'bold', color: '#FF7A18' }}>39</Text>
            <Box style={{ flexDirection: 'column', paddingBottom: 8 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>类表面缺陷覆盖</Text>
                <Text style={{ fontSize: 16, color: '#8FA6BC', marginTop: 4 }}>钢材 / 金属表面主流缺陷形态</Text>
            </Box>
        </Box>
    </Box>

    {/* 右下落款 */}
    <Box style={{ position: 'absolute', right: 84, bottom: 46, zIndex: 2, flexDirection: 'column', alignItems: 'flex-end' }}>
        <Box style={{ width: 56, height: 3, background: '#00B4D8', marginBottom: 12 }} />
        <Text style={{ fontSize: 17, color: '#B9C9DA', letterSpacing: 1 }}>应用场景与落地地图</Text>
        <Text style={{ fontSize: 15, color: '#6E8299', marginTop: 6, letterSpacing: 1 }}>项目组 · 2026-10</Text>
    </Box>

</Slide>
