<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#061428', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, flexDirection: 'row' }}>

        {/* 左侧 42% 文字（镜像构图，与 P6 区分） */}
        <Box style={{ width: 520, height: 720, paddingLeft: 96, paddingRight: 40, paddingTop: 236, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#00B4D8', letterSpacing: 3 }}>CHAPTER 03</Text>
                <Box style={{ width: 70, height: 2, background: 'rgba(255,255,255,0.25)' }} />
            </Box>
            <Text style={{ marginTop: 26, fontSize: 58, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.15, letterSpacing: 2 }}>
                技术底座：<br />为什么是这套方案
            </Text>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginTop: 34 }}>
                <Box style={{ width: 6, height: 34, background: '#FF7A18' }} />
