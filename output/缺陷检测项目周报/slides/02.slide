<Slide style={{ width: 1280, height: 720, padding: 0, flexDirection: "column", background: "#FFFFFF", fontFamily: 'Inter, "Microsoft YaHei", sans-serif' }}>
    <Box style={{ height: 120, paddingLeft: 84, paddingRight: 84, flexDirection: "row", alignItems: "center", gap: 18 }}>
        <Box style={{ width: 5, height: 36, background: "#0B3D91" }} />
        <Box style={{ flexDirection: "column" }}>
            <Text style={{ fontSize: 36, fontWeight: "bold", color: "#0B1C33", lineHeight: 1.3 }}>目录</Text>
            <Text style={{ fontSize: 14, color: "#9AA9B8", marginTop: 4 }}>3 章 · 14 页 · 2026-10-12 ~ 10-15</Text>
        </Box>
    </Box>
    <Box style={{ height: 540, paddingLeft: 84, paddingRight: 84, paddingTop: 16, paddingBottom: 24, flexDirection: "row", gap: 56 }}>
        <Box style={{ width: 380, flexDirection: "column", paddingTop: 12 }}>
            <Text style={{ fontSize: 24, fontWeight: "bold", color: "#0B1C33", lineHeight: 1.4 }}>这一周的主线</Text>
            <Text style={{ fontSize: 16, color: "#5C6E82", lineHeight: 1.75, marginTop: 16 }}>不是加功能，而是把「尺子」校准——先定板端配置，再确认评估集本身是否可信。</Text>
            <Box style={{ marginTop: 26, padding: 18, background: "#F4F7FB", borderRadius: 10, borderLeft: "4px solid #00B4D8" }}>
                <Text style={{ fontSize: 15, color: "#0B3D91", fontWeight: "bold", lineHeight: 1.7 }}>一句话结论：模型精度被评估集的漏标系统性低估，约 2.5 ~ 3.5pp。</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: "column", justifyContent: "flex-start" }}>
            <Box style={{ flexDirection: "row", gap: 22, alignItems: "flex-start", paddingTop: 14, paddingBottom: 22, borderBottom: "1px solid #E1E9F2" }}>
                <Box style={{ width: 66 }}><Text style={{ fontSize: 40, fontWeight: "bold", color: "#0B3D91", lineHeight: 1, opacity: 0.3 }}>01</Text></Box>
                <Box style={{ flexDirection: "column", gap: 8 }}>
                    <Text style={{ fontSize: 20, fontWeight: "bold", color: "#0B1C33" }}>板端落地与选型验证</Text>
                    <Text style={{ fontSize: 15, color: "#5C6E82", lineHeight: 1.6 }}>新模型、新阈值上线前，先用 300 张 holdout 做四格实测，让数据决定配置。</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: "row", gap: 22, alignItems: "flex-start", paddingTop: 22, paddingBottom: 22, borderBottom: "1px solid #E1E9F2" }}>
                <Box style={{ width: 66 }}><Text style={{ fontSize: 40, fontWeight: "bold", color: "#0B3D91", lineHeight: 1, opacity: 0.3 }}>02</Text></Box>
                <Box style={{ flexDirection: "column", gap: 8 }}>
                    <Text style={{ fontSize: 20, fontWeight: "bold", color: "#0B1C33" }}>质量瓶颈归因</Text>
                    <Text style={{ fontSize: 15, color: "#5C6E82", lineHeight: 1.6 }}>mAP 卡在 0.72：先排除背景误报与 NMS，再定位到真正的原因。</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: "row", gap: 22, alignItems: "flex-start", paddingTop: 22, paddingBottom: 22 }}>
                <Box style={{ width: 66 }}><Text style={{ fontSize: 40, fontWeight: "bold", color: "#0B3D91", lineHeight: 1, opacity: 0.3 }}>03</Text></Box>
                <Box style={{ flexDirection: "column", gap: 8 }}>
                    <Text style={{ fontSize: 20, fontWeight: "bold", color: "#0B1C33" }}>评估集重建与重训</Text>
                    <Text style={{ fontSize: 15, color: "#5C6E82", lineHeight: 1.6 }}>全池分层重划分让 39 类样本均衡，再按新评估集重训 100 轮。</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, paddingLeft: 84, paddingRight: 84, flexDirection: "row", justifyContent: "space-between", alignItems: "center", borderTop: "1px solid #E1E9F2" }}>
        <Box style={{ flexDirection: "row", alignItems: "center", gap: 10 }}>
            <Box style={{ width: 24, height: 24, background: "#0B3D91", borderRadius: 4, alignItems: "center", justifyContent: "center" }}>
                <Text style={{ fontSize: 12, color: "#FFFFFF", fontWeight: "bold" }}>DD</Text>
            </Box>
            <Text style={{ fontSize: 14, color: "#9AA9B8" }}>工业表面缺陷检测系统 · 周报</Text>
        </Box>
        <Text style={{ fontSize: 14, color: "#9AA9B8" }}>02 / 14</Text>
    </Box>
</Slide>
