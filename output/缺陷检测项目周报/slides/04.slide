<Slide style={{ width: 1280, height: 720, padding: 0, flexDirection: "column", background: "#FFFFFF", fontFamily: 'Inter, "Microsoft YaHei", sans-serif' }}>
    <Box style={{ height: 120, paddingLeft: 84, paddingRight: 84, flexDirection: "row", alignItems: "center", gap: 18 }}>
        <Box style={{ width: 5, height: 36, background: "#0B3D91" }} />
        <Box style={{ flexDirection: "column" }}>
            <Text style={{ fontSize: 36, fontWeight: "bold", color: "#0B1C33", lineHeight: 1.3 }}>上线前先做一次四格对照</Text>
            <Text style={{ fontSize: 14, color: "#9AA9B8", marginTop: 4 }}>把模型与阈值当作两个独立变量，正交组合</Text>
        </Box>
    </Box>
    <Box style={{ height: 540, paddingLeft: 84, paddingRight: 84, paddingTop: 16, paddingBottom: 24, flexDirection: "row", gap: 48 }}>
        <Box style={{ width: 384, flexDirection: "column", paddingTop: 8 }}>
            <Text style={{ fontSize: 24, fontWeight: "bold", color: "#0B1C33", lineHeight: 1.4 }}>两个变量，四种组合</Text>
            <Text style={{ fontSize: 16, color: "#5C6E82", lineHeight: 1.75, marginTop: 16 }}>上线前不赌「新的一定更好」：把「模型」与「阈值」拆成两个变量，正交组合成四格，逐格实测再定。</Text>
            <Box style={{ marginTop: 24, padding: 16, background: "#F4F7FB", borderRadius: 10, borderLeft: "4px solid #00B4D8" }}>
                <Text style={{ fontSize: 15, color: "#0B3D91", fontWeight: "bold", lineHeight: 1.7 }}>判据：300 张 holdout（seed 20261013），走真实板端 socket 送检，NMS / 匹配口径统一。</Text>
            </Box>
            <Box style={{ flexDirection: "column", gap: 10, marginTop: 24 }}>
                <Box style={{ flexDirection: "row", alignItems: "center", gap: 10 }}>
                    <Box style={{ width: 8, height: 8, borderRadius: 4, background: "#0B3D91" }} />
                    <Text style={{ fontSize: 15, color: "#5C6E82" }}>模型：旧 50 轮　vs　新 100 轮（e100）</Text>
                </Box>
                <Box style={{ flexDirection: "row", alignItems: "center", gap: 10 }}>
                    <Box style={{ width: 8, height: 8, borderRadius: 4, background: "#00B4D8" }} />
                    <Text style={{ fontSize: 15, color: "#5C6E82" }}>阈值：统一 0.20　vs　13 类标定</Text>
                </Box>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: "column", gap: 12, justifyContent: "center" }}>
            <Box style={{ flexDirection: "row", gap: 12 }}>
                <Box style={{ width: 92 }} />
                <Box style={{ flex: 1, alignItems: "center", paddingBottom: 4 }}><Text style={{ fontSize: 15, fontWeight: "bold", color: "#5C6E82" }}>统一 0.20</Text></Box>
                <Box style={{ flex: 1, alignItems: "center", paddingBottom: 4 }}><Text style={{ fontSize: 15, fontWeight: "bold", color: "#5C6E82" }}>13 类标定</Text></Box>
            </Box>
            <Box style={{ flexDirection: "row", gap: 12 }}>
                <Box style={{ width: 92, justifyContent: "center" }}><Text style={{ fontSize: 15, fontWeight: "bold", color: "#5C6E82" }}>旧 50 轮</Text></Box>
                <Box style={{ flex: 1, height: 126, background: "#F4F7FB", borderRadius: 10, border: "1px solid #E1E9F2", padding: 14, flexDirection: "column", justifyContent: "space-between" }}>
                    <Text style={{ fontSize: 26, fontWeight: "bold", color: "#0B3D91" }}>A</Text>
                    <Text style={{ fontSize: 14, color: "#5C6E82", lineHeight: 1.5 }}>旧 50 轮　+　统一 0.20</Text>
                </Box>
                <Box style={{ flex: 1, height: 126, background: "#F4F7FB", borderRadius: 10, border: "1px solid #E1E9F2", padding: 14, flexDirection: "column", justifyContent: "space-between" }}>
                    <Text style={{ fontSize: 26, fontWeight: "bold", color: "#0B3D91" }}>D</Text>
                    <Text style={{ fontSize: 14, color: "#5C6E82", lineHeight: 1.5 }}>旧 50 轮　+　13 类标定</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: "row", gap: 12 }}>
                <Box style={{ width: 92, justifyContent: "center" }}><Text style={{ fontSize: 15, fontWeight: "bold", color: "#5C6E82" }}>新 e100</Text></Box>
                <Box style={{ flex: 1, height: 126, background: "#F4F7FB", borderRadius: 10, border: "1px solid #E1E9F2", padding: 14, flexDirection: "column", justifyContent: "space-between" }}>
                    <Text style={{ fontSize: 26, fontWeight: "bold", color: "#0B3D91" }}>B</Text>
                    <Text style={{ fontSize: 14, color: "#5C6E82", lineHeight: 1.5 }}>新 e100　+　统一 0.20</Text>
                </Box>
                <Box style={{ flex: 1, height: 126, background: "#F4F7FB", borderRadius: 10, border: "1px solid #E1E9F2", padding: 14, flexDirection: "column", justifyContent: "space-between" }}>
                    <Text style={{ fontSize: 26, fontWeight: "bold", color: "#0B3D91" }}>C</Text>
                    <Text style={{ fontSize: 14, color: "#5C6E82", lineHeight: 1.5 }}>新 e100　+　13 类标定</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, paddingLeft: 84, paddingRight: 84, flexDirection: "row", justifyContent: "space-between", alignItems: "center", borderTop: "1px solid #E1E9F2" }}>
        <Box style={{ flexDirection: "row", alignItems: "center", gap: 10 }}>
            <Box style={{ width: 24, height: 24, background: "#0B3D91", borderRadius: 4, alignItems: "center", justifyContent: "center" }}>
                <Text style={{ fontSize: 12, color: "#FFFFFF", fontWeight: "bold" }}>DD</Text>
            </Box>
            <Text style={{ fontSize: 14, color: "#9AA9B8" }}>工业表面缺陷检测系统 · 周报</Text>
        </Box>
        <Text style={{ fontSize: 14, color: "#9AA9B8" }}>04 / 14</Text>
    </Box>
</Slide>
